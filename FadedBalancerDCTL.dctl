DEFINE_UI_PARAMS(blueHighlights, 🔵 Blue Gain, DCTLUI_SLIDER_FLOAT, 1.0f,  0.1f, 3.0f, 0.001f)

// Stage 4: Preserve Luminance (applies after per-channel)
DEFINE_UI_PARAMS(preserveLuminance, ⚖️ Preserve Luminance, DCTLUI_CHECK_BOX, 0)

// Stage 5: Channel Mixer (RGB matrix transformation)
DEFINE_UI_PARAMS(redOutGreenIn, 🔴📈 Red from G, DCTLUI_SLIDER_FLOAT, 0.0f, -2.0f, 2.0f, 0.001f)
