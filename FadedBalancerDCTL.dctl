// Stage 6: Enhanced mixing controls (darken/lighten with shadow/highlight targeting and donor luminance)
DEFINE_UI_PARAMS(mixingShadowsStrength, 🎭 Mixing Shadows, DCTLUI_SLIDER_FLOAT, 1.0f, 0.0f, 1.0f, 0.001f)
