// Helper functions used in the processing pipeline (GPU‑safe).
// Map:
// - safeSignedPow: full-float signed power with exact neutral identity
// - applyLGGO: legacy Offset/Lift/Gamma/Gain adjustment
// - applyFadeCorrection: deterministic luma/chroma curve with full-float extension
// - diagnosticLogPreview: monotonic positive display compression

__DEVICE__ float safeSignedPow(float value, float exponent) {
    if (isnan(value) || isinf(value) || isnan(exponent) || isinf(exponent)) return value;
    if (_fabs(exponent - 1.0f) <= 1e-7f) return value;
    float magnitude = _powf(_fabs(value), exponent);
    if (isnan(magnitude) || isinf(magnitude)) return value;
    return (value < 0.0f) ? -magnitude : magnitude;
}

// Two-point faded-channel recovery helpers. Channel IDs are Red=0, Green=1,
// Blue=2. The UI mode is Off=0, Auto=1, Red=2, Green=3, Blue=4.
__DEVICE__ float recoveryChannelValue(float3 value, int channel) {
    if (channel == 0) return value.x;
    if (channel == 1) return value.y;
    return value.z;
}

__DEVICE__ float3 setRecoveryChannelValue(float3 value, int channel, float replacement) {
    if (channel == 0) value.x = replacement;
    else if (channel == 1) value.y = replacement;
    else value.z = replacement;
    return value;
}

__DEVICE__ float recoveryOtherMean(float3 value, int channel) {
    if (channel == 0) return 0.5f * (value.y + value.z);
    if (channel == 1) return 0.5f * (value.x + value.z);
    return 0.5f * (value.x + value.y);
}

__DEVICE__ int recoverySampleFinite(float3 sample) {
    return (!isnan(sample.x) && !isinf(sample.x) &&
        !isnan(sample.y) && !isinf(sample.y) &&
        !isnan(sample.z) && !isinf(sample.z)) ? 1 : 0;
}

// The picker defaults are also the setup-state sentinels. An all-zero dark
// sample and all-one bright sample are clipped endpoints and are unsuitable for
// recovery anyway, so treating them as "not picked" is fail-safe.
__DEVICE__ int recoveryDarkSampleReady(float3 darkSample) {
    if (recoverySampleFinite(darkSample) == 0) return 0;
    float distanceFromDefault = _fmaxf(_fabs(darkSample.x),
        _fmaxf(_fabs(darkSample.y), _fabs(darkSample.z)));
    return (distanceFromDefault > 1e-6f) ? 1 : 0;
}

__DEVICE__ int recoveryBrightSampleReady(float3 brightSample) {
    if (recoverySampleFinite(brightSample) == 0) return 0;
    float distanceFromDefault = _fmaxf(_fabs(brightSample.x - 1.0f),
        _fmaxf(_fabs(brightSample.y - 1.0f), _fabs(brightSample.z - 1.0f)));
    return (distanceFromDefault > 1e-6f) ? 1 : 0;
}

__DEVICE__ int recoverySamplesValid(float3 darkSample, float3 brightSample) {
    if (recoverySampleFinite(darkSample) == 0 ||
        recoverySampleFinite(brightSample) == 0) return 0;

    float3 span = brightSample - darkSample;
    return (span.x > 1e-6f && span.y > 1e-6f && span.z > 1e-6f) ? 1 : 0;
}

// Before the bright sample exists, Auto can make a provisional dark-point
// choice only when one channel lies uniquely outside the range of the other
// two. This gives immediate Step 1 feedback while remaining conservative.
__DEVICE__ float recoveryDarkCandidateScore(float3 darkSample, int channel) {
    float target = recoveryChannelValue(darkSample, channel);
    float peerMin;
    float peerMax;
    if (channel == 0) {
        peerMin = _fminf(darkSample.y, darkSample.z);
        peerMax = _fmaxf(darkSample.y, darkSample.z);
    } else if (channel == 1) {
        peerMin = _fminf(darkSample.x, darkSample.z);
        peerMax = _fmaxf(darkSample.x, darkSample.z);
    } else {
        peerMin = _fminf(darkSample.x, darkSample.y);
        peerMax = _fmaxf(darkSample.x, darkSample.y);
    }
    return _fmaxf(0.0f, _fmaxf(peerMin - target, target - peerMax));
}

__DEVICE__ int recoveryDarkTargetChannel(float3 darkSample, int mode) {
    if (mode >= 2 && mode <= 4) return mode - 2;
    if (mode != 1 || recoveryDarkSampleReady(darkSample) == 0) return -1;

    float redScore = recoveryDarkCandidateScore(darkSample, 0);
    float greenScore = recoveryDarkCandidateScore(darkSample, 1);
    float blueScore = recoveryDarkCandidateScore(darkSample, 2);
    float threshold = 0.02f;
    float uniqueMargin = 1e-6f;

    if (redScore > threshold && redScore > greenScore + uniqueMargin &&
        redScore > blueScore + uniqueMargin) return 0;
    if (greenScore > threshold && greenScore > redScore + uniqueMargin &&
        greenScore > blueScore + uniqueMargin) return 1;
    if (blueScore > threshold && blueScore > redScore + uniqueMargin &&
        blueScore > greenScore + uniqueMargin) return 2;
    return -1;
}

// Conservative Auto score: select a channel only when it is uniquely narrower
// than both peers, or shifted lower at both sampled endpoints. Two neutral
// samples cannot distinguish subtler scene colour from fading, so ambiguity is
// an intentional identity result.
__DEVICE__ float recoveryCandidateScore(float3 darkSample, float3 brightSample, int channel) {
    float3 span = brightSample - darkSample;
    float targetSpan = recoveryChannelValue(span, channel);
    float referenceSpan = recoveryOtherMean(brightSample, channel) -
        recoveryOtherMean(darkSample, channel);
    if (targetSpan <= 1e-6f || referenceSpan <= 1e-6f) return 0.0f;

    float peerSpanMin;
    float peerDarkMin;
    float peerBrightMin;
    if (channel == 0) {
        peerSpanMin = _fminf(span.y, span.z);
        peerDarkMin = _fminf(darkSample.y, darkSample.z);
        peerBrightMin = _fminf(brightSample.y, brightSample.z);
    } else if (channel == 1) {
        peerSpanMin = _fminf(span.x, span.z);
        peerDarkMin = _fminf(darkSample.x, darkSample.z);
        peerBrightMin = _fminf(brightSample.x, brightSample.z);
    } else {
        peerSpanMin = _fminf(span.x, span.y);
        peerDarkMin = _fminf(darkSample.x, darkSample.y);
        peerBrightMin = _fminf(brightSample.x, brightSample.y);
    }

    float spanMargin = (peerSpanMin - targetSpan) / referenceSpan;
    float darkMargin = (peerDarkMin - recoveryChannelValue(darkSample, channel)) /
        referenceSpan;
    float brightMargin = (peerBrightMin - recoveryChannelValue(brightSample, channel)) /
        referenceSpan;
    float levelMargin = _fminf(darkMargin, brightMargin);
    return _fmaxf(0.0f, _fmaxf(spanMargin, levelMargin));
}

__DEVICE__ int recoveryTargetChannel(float3 darkSample, float3 brightSample, int mode) {
    if (mode >= 2 && mode <= 4) return mode - 2;
    if (mode != 1 || recoverySamplesValid(darkSample, brightSample) == 0) return -1;

    float redScore = recoveryCandidateScore(darkSample, brightSample, 0);
    float greenScore = recoveryCandidateScore(darkSample, brightSample, 1);
    float blueScore = recoveryCandidateScore(darkSample, brightSample, 2);
    float threshold = 0.02f;
    float uniqueMargin = 1e-6f;

    if (redScore > threshold && redScore > greenScore + uniqueMargin &&
        redScore > blueScore + uniqueMargin) return 0;
    if (greenScore > threshold && greenScore > redScore + uniqueMargin &&
        greenScore > blueScore + uniqueMargin) return 1;
    if (blueScore > threshold && blueScore > redScore + uniqueMargin &&
        blueScore > greenScore + uniqueMargin) return 2;
    return -1;
}

__DEVICE__ float3 applyRangeRecovery(float3 color, float3 darkSample,
    float3 brightSample, int mode, float strength, float maximumGain) {
    if (mode == 0 || strength <= 0.0f) return color;
    if (isnan(strength) || isinf(strength) ||
        isnan(maximumGain) || isinf(maximumGain)) return color;
    if (recoverySampleFinite(darkSample) == 0 ||
        recoverySampleFinite(brightSample) == 0) return color;
    if (recoveryDarkSampleReady(darkSample) == 0) return color;

    int brightReady = recoveryBrightSampleReady(brightSample);
    if (brightReady != 0 &&
        recoverySamplesValid(darkSample, brightSample) == 0) return color;

    int channel = (brightReady != 0) ?
        recoveryTargetChannel(darkSample, brightSample, mode) :
        recoveryDarkTargetChannel(darkSample, mode);
    if (channel < 0) return color;

    float targetBlack = recoveryChannelValue(darkSample, channel);
    float referenceBlack = recoveryOtherMean(darkSample, channel);
    float inputValue = recoveryChannelValue(color, channel);
    float darkOffset = referenceBlack - targetBlack;
    float darkCorrectedValue = inputValue + darkOffset;
    float mappedValue = darkCorrectedValue;

    if (brightReady != 0) {
        float targetWhite = recoveryChannelValue(brightSample, channel);
        float referenceWhite = recoveryOtherMean(brightSample, channel);

        // Picker 2 is in the node-input domain. Concatenate Step 1 by applying
        // its offset to the stored bright value, then stretch around the
        // corrected black pivot. At full strength this is the same affine math
        // as a dark-offset stage followed by a pivoted white-point stage.
        float correctedTargetWhite = targetWhite + darkOffset;
        float correctedTargetSpan = correctedTargetWhite - referenceBlack;
        float referenceSpan = referenceWhite - referenceBlack;
        if (correctedTargetSpan <= 1e-6f || referenceSpan <= 1e-6f) return color;

        float rawGain = referenceSpan / correctedTargetSpan;
        if (rawGain <= 0.0f || isnan(rawGain) || isinf(rawGain)) return color;
        float gainLimit = _fmaxf(1.0f, _fminf(maximumGain, 8.0f));
        float gain = _fminf(rawGain, gainLimit);
        mappedValue = referenceBlack +
            (darkCorrectedValue - referenceBlack) * gain;
    }

    float outputValue = inputValue +
        _fmaxf(0.0f, _fminf(strength, 1.0f)) * (mappedValue - inputValue);
    if ((isnan(outputValue) || isinf(outputValue)) &&
        !(isnan(inputValue) || isinf(inputValue))) return color;
    return setRecoveryChannelValue(color, channel, outputValue);
}

// applyLGGO: legacy per-channel Offset/Lift/Gamma/Gain.
//   col: input color
//   offset: additive
//   lift: legacy additive control retained for saved-grade compatibility
//   gamma: power control (1.0 = neutral)
//   gain: scale (1.0 = neutral)
__DEVICE__ float3 applyLGGO(float3 col, float3 offset, float3 shadows, float3 midtones, float3 highlights) {
    col += offset;
    col += shadows;
    col.x = safeSignedPow(col.x, 1.0f / midtones.x);
    col.y = safeSignedPow(col.y, 1.0f / midtones.y);
    col.z = safeSignedPow(col.z, 1.0f / midtones.z);
    col *= highlights;
    return col;
}

// applyFadeCorrection: deterministic luma-dependent contrast and saturation
// nudge. Within 0..1 it preserves the legacy curve. Below black and above one,
// the bounded curve delta is zero so full-float excursions remain monotonic.
__DEVICE__ float3 applyFadeCorrection(float3 col, float fadeCorrection) {
    if (fadeCorrection > 0.0f && !isnan(fadeCorrection) && !isinf(fadeCorrection)) {
        float amount = _fmaxf(0.0f, _fminf(fadeCorrection, 1.0f));
        float luma = col.x * 0.2126f + col.y * 0.7152f + col.z * 0.0722f;
        float boundedLuma = _fmaxf(0.0f, _fminf(luma, 1.0f));
        float boundedContrast = boundedLuma * boundedLuma * (3.0f - 2.0f * boundedLuma);
        float contrastedLuma = luma + (boundedContrast - boundedLuma);
        float finalLuma = _mix(luma, contrastedLuma, amount);
        float3 lumaColor = make_float3(luma, luma, luma);
        // Preserve the legacy gentle response explicitly: effective chroma
        // scale is 1 + amount^2, reaching 2x only at maximum.
        float satScale = 1.0f + amount * amount;
        col = lumaColor + (col - lumaColor) * satScale;
        float newLuma = col.x * 0.2126f + col.y * 0.7152f + col.z * 0.0722f;
        if (_fabs(newLuma) > 1e-9f) {
            float lumaScale = finalLuma / newLuma;
            if (!isnan(lumaScale) && !isinf(lumaScale)) col *= lumaScale;
        }
    }
    return col;
}

// Monotonic positive display compression. This is intentionally not labelled
// Cineon: it is an inspection view, not a color-space or delivery transform.
__DEVICE__ float diagnosticLogPreview(float value) {
    if (isnan(value) || value <= 0.0f) return 0.0f;
    if (isinf(value)) return 1.0f;
    return 1.0f - 1.0f / (1.0f + value);
}

__DEVICE__ float mixingTonalMask(float3 col, float shadowStrength, float highlightStrength) {
    float luma = col.x * 0.2126f + col.y * 0.7152f + col.z * 0.0722f;
    float boundedLuma = _fmaxf(0.0f, _fminf(luma, 1.0f));
    float highlightMask = boundedLuma * boundedLuma;
    float shadowMask = 1.0f - highlightMask;
    float mask = shadowMask * shadowStrength + highlightMask * highlightStrength;
    return _fmaxf(0.0f, _fminf(1.0f, mask));
}

// applyEnhancedMixing: min/max channel composites with broad shadow/highlight
// weighting. If both operations target one channel, Darken is evaluated first
// and Lighten second. The legacy Donor Luminance control scales donor values.
__DEVICE__ float3 applyEnhancedMixing(float3 col,
    int redDarken, int redLighten, int greenDarken, int greenLighten, int blueDarken, int blueLighten,
    float shadowStrength, float highlightStrength, float donorLuminance) {

    float mixingMask = mixingTonalMask(col, shadowStrength, highlightStrength);

    // Store original values
    float3 originalRGB = col;
    float3 mixedRGB = col;

    // Create luminance-adjusted donor channels for mixing
    float3 adjustedDonors = col * donorLuminance;

    // Apply enhanced mixing operations with luminance-adjusted donors
    if (redDarken == 1) mixedRGB.x = _fminf(mixedRGB.x, adjustedDonors.y);      // Red darken with adjusted green
    else if (redDarken == 2) mixedRGB.x = _fminf(mixedRGB.x, adjustedDonors.z); // Red darken with adjusted blue

    if (redLighten == 1) mixedRGB.x = _fmaxf(mixedRGB.x, adjustedDonors.y);     // Red lighten with adjusted green
    else if (redLighten == 2) mixedRGB.x = _fmaxf(mixedRGB.x, adjustedDonors.z); // Red lighten with adjusted blue

    if (greenDarken == 1) mixedRGB.y = _fminf(mixedRGB.y, adjustedDonors.x);    // Green darken with adjusted red
    else if (greenDarken == 2) mixedRGB.y = _fminf(mixedRGB.y, adjustedDonors.z); // Green darken with adjusted blue

    if (greenLighten == 1) mixedRGB.y = _fmaxf(mixedRGB.y, adjustedDonors.x);   // Green lighten with adjusted red
    else if (greenLighten == 2) mixedRGB.y = _fmaxf(mixedRGB.y, adjustedDonors.z); // Green lighten with adjusted blue

    if (blueDarken == 1) mixedRGB.z = _fminf(mixedRGB.z, adjustedDonors.x);     // Blue darken with adjusted red
    else if (blueDarken == 2) mixedRGB.z = _fminf(mixedRGB.z, adjustedDonors.y); // Blue darken with adjusted green

    if (blueLighten == 1) mixedRGB.z = _fmaxf(mixedRGB.z, adjustedDonors.x);    // Blue lighten with adjusted red
    else if (blueLighten == 2) mixedRGB.z = _fmaxf(mixedRGB.z, adjustedDonors.y); // Blue lighten with adjusted green

    // Blend between original and mixed based on tonal mask
    return _mix(originalRGB, mixedRGB, mixingMask);
}

// applyChannelIsolation: isolate a single channel for preview
__DEVICE__ float3 applyChannelIsolation(float3 col, int isolationMode) {
    if (isolationMode == ISO_RED) {
        return make_float3(col.x, col.x, col.x);  // Show red as grayscale
    } else if (isolationMode == ISO_GREEN) {
        return make_float3(col.y, col.y, col.y);  // Show green as grayscale
    } else if (isolationMode == ISO_BLUE) {
        return make_float3(col.z, col.z, col.z);  // Show blue as grayscale
    }
    return col; // ISO_NONE - normal view
}


// === MAIN TRANSFORM === (RGB-only signature for Resolve Transform DCTL)
__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B) {
    // Preserve incoming pixel
    float3 rgb = make_float3(p_R, p_G, p_B);

    // --- 0. Assisted two-point faded-channel recovery
    // The picker samples describe this DCTL's input domain, so recovery must
    // precede presets and every other grading operation.
    // Resolve exposes a color-picker UI value as DCTLColorPickerParam, not as
    // float3, so copy its RGB components into host-independent vectors first.
    float3 recoveryDarkSample = make_float3(
        rangeRecoveryDark.r, rangeRecoveryDark.g, rangeRecoveryDark.b);
    float3 recoveryBrightSample = make_float3(
        rangeRecoveryBright.r, rangeRecoveryBright.g, rangeRecoveryBright.b);
    rgb = applyRangeRecovery(rgb, recoveryDarkSample, recoveryBrightSample,
        rangeRecoveryMode, rangeRecoveryStrength, rangeRecoveryMaxGain);

    // --- local copies of UI params (presets only modify these)
    float fadeCorrection_l          = fadeCorrection;
    float mixingShadowsStrength_l   = mixingShadowsStrength;
    float mixingHighlightsStrength_l = mixingHighlightsStrength;
    float donorLuminanceAdjust_l    = donorLuminanceAdjust;
    int presetTonalOnly_l           = (presetTonalOnly > 0.5f) ? 1 : 0;
    int channelIsolation_l          = channelIsolation;
    float globalOffset_l            = globalOffset;
    float globalShadows_l     = globalShadows;
    float globalMidtones_l    = globalMidtones;
    float globalHighlights_l  = globalHighlights;
    float preserveLuminance_l = preserveLuminance;

    float redOffset_l     = redOffset;     float redShadows_l    = redShadows;    float redMidtones_l   = redMidtones;   float redHighlights_l   = redHighlights;
    float greenOffset_l   = greenOffset;   float greenShadows_l  = greenShadows;  float greenMidtones_l = greenMidtones; float greenHighlights_l = greenHighlights;
    float blueOffset_l    = blueOffset;    float blueShadows_l   = blueShadows;   float blueMidtones_l  = blueMidtones;  float blueHighlights_l  = blueHighlights;

    // local copies for combo / copy / removal / output so presets can suggest them:
    int redDarkenWith_l    = redDarkenWith;
    int redLightenWith_l   = redLightenWith;
    int greenDarkenWith_l  = greenDarkenWith;
    int greenLightenWith_l = greenLightenWith;
    int blueDarkenWith_l   = blueDarkenWith;
    int blueLightenWith_l  = blueLightenWith;

    int copyRedSource_l    = copyRedSource;
    int copyGreenSource_l  = copyGreenSource;
    int copyBlueSource_l   = copyBlueSource;

    int channelRemovalMode_l = channelRemovalMode;
    int outputToCineon_l     = (outputToCineon > 0.5f) ? 1 : 0;

    // --- PRESET PRE-TRANSFORM
    // prepare local preset suggestions (no UI overwrite)
    int preset_applied = 0;
    float p_globalOffset = 0.0f;
    float p_globalShadows = 0.0f;
    float p_globalMidtones = 1.0f;
    float p_globalHighlights = 1.0f;

    float p_redOffset = 0.0f;   float p_redShadows = 0.0f;   float p_redMidtones = 1.0f;   float p_redHighlights = 1.0f;
    float p_greenOffset = 0.0f; float p_greenShadows = 0.0f; float p_greenMidtones = 1.0f; float p_greenHighlights = 1.0f;
    float p_blueOffset = 0.0f;  float p_blueShadows = 0.0f;  float p_blueMidtones = 1.0f;  float p_blueHighlights = 1.0f;

    int p_blueDarkenWith = BDW_NONE; // presets may still suggest channel darken mix

    // Preset definitions (1-10): set local suggestion values only.

    // 1: Red Compress Mid (most used) — contrast tweaked (lower offset, moderated highlights)
    if (presetMode == PRESET_EASTMAN1) {
        preset_applied = 1;
        p_globalOffset = 0.090f; p_globalShadows = 0.000f; p_globalMidtones = 1.000f; p_globalHighlights = 0.920f; // was 0.112 / 0.819 / 0.950
        p_redOffset = 0.000f; p_redShadows = 0.000f; p_redMidtones = 0.437f; p_redHighlights = 1.426f;
        p_greenOffset = 0.000f; p_greenShadows = 0.000f; p_greenMidtones = 1.000f; p_greenHighlights = 1.000f;
        p_blueOffset = 0.000f; p_blueShadows = 0.000f; p_blueMidtones = 1.000f; p_blueHighlights = 1.000f;
        p_blueDarkenWith = BDW_GREEN;
    }

    // 2: Balanced Aggregate (general starting point)
    if (presetMode == PRESET_EASTMAN2) {
        preset_applied = 1;
        p_globalOffset = 0.035f; p_globalShadows = 0.000f; p_globalMidtones = 1.000f; p_globalHighlights = 1.000f;
        p_redOffset = 0.000f; p_redShadows = 0.000f; p_redMidtones = 0.325f; p_redHighlights = 1.269f;
        p_greenOffset = 0.000f; p_greenShadows = 0.000f; p_greenMidtones = 1.000f; p_greenHighlights = 1.000f;
        p_blueOffset = 0.000f; p_blueShadows = 0.000f; p_blueMidtones = 1.000f; p_blueHighlights = 1.000f;
        p_blueDarkenWith = BDW_GREEN; // modal
    }

    // 3: Red Compress Hi Lift (red mid compression + modest highlight gain)
    if (presetMode == PRESET_EASTMAN3) {
        preset_applied = 1;
        p_globalOffset = 0.043f; p_globalShadows = 0.000f; p_globalMidtones = 1.000f; p_globalHighlights = 1.112f;
        p_redOffset = 0.000f; p_redShadows = 0.000f; p_redMidtones = 0.212f; p_redHighlights = 1.269f;
        p_greenOffset = 0.000f; p_greenShadows = 0.000f; p_greenMidtones = 1.000f; p_greenHighlights = 1.000f;
        p_blueOffset = 0.000f; p_blueShadows = 0.000f; p_blueMidtones = 1.000f; p_blueHighlights = 1.000f;
        p_blueDarkenWith = BDW_GREEN;
    }

    // 4: Red Comp Blue Tweak (adds slight blue shadow reduction)
    if (presetMode == PRESET_EASTMAN4) {
        preset_applied = 1;
        p_globalOffset = 0.000f; p_globalShadows = 0.000f; p_globalMidtones = 1.000f; p_globalHighlights = 1.089f;
        p_redOffset = 0.000f; p_redShadows = 0.000f; p_redMidtones = 0.280f; p_redHighlights = 1.224f;
        p_greenOffset = 0.000f; p_greenShadows = 0.000f; p_greenMidtones = 1.000f; p_greenHighlights = 1.000f;
        p_blueOffset = 0.000f; p_blueShadows = -0.050f; p_blueMidtones = 1.000f; p_blueHighlights = 1.000f;
    }

    // 5: Heavy Red Crush (extreme red compression & highlight gain)
    if (presetMode == PRESET_EASTMAN5) {
        preset_applied = 1;
    // Use values derived from Preset_01 (Heavy Red Crush sample)
    p_globalOffset = 0.074f; p_globalShadows = 0.000f; p_globalMidtones = 1.000f; p_globalHighlights = 0.887f;
    p_redOffset = -0.229f; p_redShadows = -0.500f; p_redMidtones = 1.471f; p_redHighlights = 3.000f;
        p_greenOffset = 0.000f; p_greenShadows = 0.000f; p_greenMidtones = 1.000f; p_greenHighlights = 0.954f;
        p_blueOffset = 0.000f; p_blueShadows = 0.000f; p_blueMidtones = 1.000f; p_blueHighlights = 1.000f;
        p_blueDarkenWith = BDW_GREEN;
    }

    // 6: Mild Corrective (light overall balance)
    if (presetMode == PRESET_EASTMAN6) {
        preset_applied = 1;
        p_globalOffset = 0.097f; p_globalShadows = 0.000f; p_globalMidtones = 1.000f; p_globalHighlights = 0.842f;
        p_redOffset = 0.000f; p_redShadows = 0.000f; p_redMidtones = 0.325f; p_redHighlights = 1.000f;
        p_greenOffset = 0.000f; p_greenShadows = 0.000f; p_greenMidtones = 1.000f; p_greenHighlights = 1.000f;
        p_blueOffset = 0.000f; p_blueShadows = 0.000f; p_blueMidtones = 1.000f; p_blueHighlights = 1.067f;
        p_blueDarkenWith = BDW_GREEN;
    }

    // 7: Neutral Red Mid Tweak (baseline neutral with red mid compression)
    if (presetMode == PRESET_EASTMAN7) {
        preset_applied = 1;
        p_globalOffset = -0.043f; p_globalShadows = 0.000f; p_globalMidtones = 1.000f; p_globalHighlights = 1.000f;
        p_redOffset = 0.000f; p_redShadows = 0.000f; p_redMidtones = 0.617f; p_redHighlights = 1.224f;
        p_greenOffset = 0.000f; p_greenShadows = 0.000f; p_greenMidtones = 1.000f; p_greenHighlights = 1.000f;
        p_blueOffset = 0.000f; p_blueShadows = 0.000f; p_blueMidtones = 1.000f; p_blueHighlights = 1.000f;
    }

    // 8: Strong Red Compress (strong compression & highlight lift)
    if (presetMode == PRESET_EASTMAN8) {
        preset_applied = 1;
        p_globalOffset = 0.120f; p_globalShadows = 0.000f; p_globalMidtones = 1.000f; p_globalHighlights = 0.864f;
        p_redOffset = 0.000f; p_redShadows = 0.004f; p_redMidtones = 0.235f; p_redHighlights = 1.426f;
        p_greenOffset = 0.000f; p_greenShadows = 0.000f; p_greenMidtones = 1.000f; p_greenHighlights = 1.000f;
        p_blueOffset = 0.000f; p_blueShadows = 0.000f; p_blueMidtones = 1.000f; p_blueHighlights = 1.000f;
        p_blueDarkenWith = BDW_GREEN;
    }

    // 9: Neg Offset Blue Cut (negative offset & blue shadow reduction)
    if (presetMode == PRESET_EASTMAN9) {
        preset_applied = 1;
        p_globalOffset = -0.167f; p_globalShadows = 0.000f; p_globalMidtones = 1.000f; p_globalHighlights = 1.067f;
        p_redOffset = 0.000f; p_redShadows = 0.000f; p_redMidtones = 0.235f; p_redHighlights = 1.629f;
        p_greenOffset = 0.000f; p_greenShadows = 0.000f; p_greenMidtones = 1.000f; p_greenHighlights = 1.000f;
        p_blueOffset = 0.000f; p_blueShadows = -0.260f; p_blueMidtones = 1.000f; p_blueHighlights = 1.179f;
        p_blueDarkenWith = BDW_GREEN;
    }

    // 10: Highlight Lift + Blue Shadow (Safer) — moderated highlight lift & gentler blue shadow tweak for broader footage
    if (presetMode == PRESET_EASTMAN10) {
        preset_applied = 1;
        // Reduced globalHighlights 1.247f -> 1.200f to avoid clipping risk on dense scans
        p_globalOffset = 0.035f; p_globalShadows = 0.000f; p_globalMidtones = 1.000f; p_globalHighlights = 1.200f;
        p_redOffset = 0.000f; p_redShadows = 0.000f; p_redMidtones = 1.000f; p_redHighlights = 1.000f;
        p_greenOffset = 0.000f; p_greenShadows = 0.000f; p_greenMidtones = 1.000f; p_greenHighlights = 1.000f;
        // Gentler blue shadow and highlight push: blueShadows -0.128f -> -0.080f, blueHighlights 1.089f -> 1.060f
        p_blueOffset = 0.000f; p_blueShadows = -0.080f; p_blueMidtones = 1.000f; p_blueHighlights = 1.060f;
        p_blueDarkenWith = BDW_GREEN; // matches sample 13 modal setting
    }

    // Apply preset pre-transform to original pixel first (if any preset selected).
    if (preset_applied) {
        // apply global-style preset pass first
        rgb = applyLGGO(rgb,
            make_float3(p_globalOffset, p_globalOffset, p_globalOffset),
            make_float3(p_globalShadows, p_globalShadows, p_globalShadows),
            make_float3(p_globalMidtones, p_globalMidtones, p_globalMidtones),
            make_float3(p_globalHighlights, p_globalHighlights, p_globalHighlights));

    // apply preset per-channel pass
        rgb = applyLGGO(rgb,
            make_float3(p_redOffset, p_greenOffset, p_blueOffset),
            make_float3(p_redShadows, p_greenShadows, p_blueShadows),
            make_float3(p_redMidtones, p_greenMidtones, p_blueMidtones),
            make_float3(p_redHighlights, p_greenHighlights, p_blueHighlights));

    // apply preset channel suggestions
    if (presetTonalOnly_l == 0 && p_blueDarkenWith != BDW_NONE &&
        blueDarkenWith_l == BDW_NONE) blueDarkenWith_l = p_blueDarkenWith;
    }

    // --- 1. Global Adjust (allowed to change luminance)
    rgb = applyLGGO(rgb,
        make_float3(globalOffset_l, globalOffset_l, globalOffset_l),
        make_float3(globalShadows_l, globalShadows_l, globalShadows_l),
        make_float3(globalMidtones_l, globalMidtones_l, globalMidtones_l),
        make_float3(globalHighlights_l, globalHighlights_l, globalHighlights_l));

    // --- 2. Fade Correction
    rgb = applyFadeCorrection(rgb, fadeCorrection_l);

    // Capture luma before per-channel adjustments for optional preservation.
    float preChannelLuma = rgb.x * 0.2126f + rgb.y * 0.7152f + rgb.z * 0.0722f;

    // --- 3. Per-Channel Adjust (optionally preserve luminance after this stage)
    rgb = applyLGGO(rgb,
        make_float3(redOffset_l, greenOffset_l, blueOffset_l),
        make_float3(redShadows_l, greenShadows_l, blueShadows_l),
        make_float3(redMidtones_l, greenMidtones_l, blueMidtones_l),
        make_float3(redHighlights_l, greenHighlights_l, blueHighlights_l));
    if (preserveLuminance_l > 0.5f) {
        float postChannelLuma = rgb.x * 0.2126f + rgb.y * 0.7152f + rgb.z * 0.0722f;
        if (_fabs(postChannelLuma) > 1e-9f) {
            float lumaRatio = preChannelLuma / postChannelLuma;
            if (!isnan(lumaRatio) && !isinf(lumaRatio)) rgb *= lumaRatio;
        }
    }

    // --- 5. Channel Mixer (masked additive cross-channel matrix)
    float matrixMask = mixingTonalMask(rgb,
        mixingShadowsStrength_l, mixingHighlightsStrength_l);
    float3 matrixDonors = rgb * donorLuminanceAdjust_l;
    float3 matrixCandidate;
    matrixCandidate.x = rgb.x + matrixDonors.y * redOutGreenIn + matrixDonors.z * redOutBlueIn;
    matrixCandidate.y = rgb.y + matrixDonors.x * greenOutRedIn + matrixDonors.z * greenOutBlueIn;
    matrixCandidate.z = rgb.z + matrixDonors.x * blueOutRedIn + matrixDonors.y * blueOutGreenIn;
    rgb = _mix(rgb, matrixCandidate, matrixMask);

    // --- 6. Enhanced Mixing (Darken / Lighten with shadow/highlight targeting and donor luminance adjustment)
    rgb = applyEnhancedMixing(rgb,
        redDarkenWith_l, redLightenWith_l,
        greenDarkenWith_l, greenLightenWith_l,
        blueDarkenWith_l, blueLightenWith_l,
        mixingShadowsStrength_l, mixingHighlightsStrength_l, donorLuminanceAdjust_l);

    // --- 7. Replace. Read every donor from one snapshot so multiple choices
    // are simultaneous instead of cascading in UI declaration order.
    float3 replaceSource = rgb;
    if (copyRedSource_l == CR_FROM_GREEN) rgb.x = replaceSource.y; else if (copyRedSource_l == CR_FROM_BLUE) rgb.x = replaceSource.z;
    if (copyGreenSource_l == CG_FROM_RED) rgb.y = replaceSource.x; else if (copyGreenSource_l == CG_FROM_BLUE) rgb.y = replaceSource.z;
    if (copyBlueSource_l == CB_FROM_RED) rgb.z = replaceSource.x; else if (copyBlueSource_l == CB_FROM_GREEN) rgb.z = replaceSource.y;

    // --- 8. Removal (use local removal)
    if (channelRemovalMode_l == REM_RED || channelRemovalMode_l == REM_ALL) rgb.x = 0.0f;
    if (channelRemovalMode_l == REM_GREEN || channelRemovalMode_l == REM_ALL) rgb.y = 0.0f;
    if (channelRemovalMode_l == REM_BLUE || channelRemovalMode_l == REM_ALL) rgb.z = 0.0f;

    // --- 9. Channel Isolation (for preview)
    rgb = applyChannelIsolation(rgb, channelIsolation_l);

    // --- 10. Diagnostic output view (legacy flag name retained)
    if (outputToCineon_l != 0) {
        rgb.x = diagnosticLogPreview(rgb.x);
        rgb.y = diagnosticLogPreview(rgb.y);
        rgb.z = diagnosticLogPreview(rgb.z);
    }
    return rgb;
}
