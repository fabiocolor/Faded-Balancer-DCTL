// FadedBalancerDCTL v1.7.0
// DaVinci Resolve DCTL plugin to rebalance RGB for faded film scans.
//
// Pipeline (per-pixel): two-point faded-channel recovery → presets → global → fade → per-channel → (optional preserve luma) → masked channel matrix → masked min/max mixing → replace → removal → channel isolation → optional diagnostic log preview
//
// Notes (concise):
// - Preserve Luminance: re-normalize Rec.709-weighted luma across per-channel adjustments only.
// - Presets: non‑destructive starting points; modify local copies only.
//
// --- Preset identifiers & selector
#define PRESET_NONE      0
#define PRESET_EASTMAN1  1
#define PRESET_EASTMAN2  2
#define PRESET_EASTMAN3  3
#define PRESET_EASTMAN4  4
#define PRESET_EASTMAN5  5
#define PRESET_EASTMAN6  6
#define PRESET_EASTMAN7  7
#define PRESET_EASTMAN8  8
#define PRESET_EASTMAN9  9
#define PRESET_EASTMAN10 10

DEFINE_UI_PARAMS(presetMode, Preset, DCTLUI_COMBO_BOX, 0, { PRESET_NONE, PRESET_EASTMAN1, PRESET_EASTMAN2, PRESET_EASTMAN3, PRESET_EASTMAN4, PRESET_EASTMAN5, PRESET_EASTMAN6, PRESET_EASTMAN7, PRESET_EASTMAN8, PRESET_EASTMAN9, PRESET_EASTMAN10 }, { None, Red Compress Mid, Balanced Aggregate, Red Compress Hi Lift, Red Comp Blue Tweak, Heavy Red Crush, Mild Corrective, Neutral Red Mid Tweak, Strong Red Compress, Neg Offset Blue Cut, Highlight Lift Blue Shadow })
// Resolve supplies zero for a newly introduced checkbox when an existing node
// is upgraded. Make zero the compatibility-preserving state: presets retain
// their historical optional Blue Darken request unless the user opts out.
DEFINE_UI_PARAMS(presetTonalOnly, 🧩 Preset Tonal Only, DCTLUI_CHECK_BOX, 0)
// (presetBlend removed — presets apply directly to local copies before processing)


// === UI PARAMETERS ===

// Combo enum definitions (required by DEFINE_UI_PARAMS lists)
// Darken / Lighten enums for Red
#define RDW_NONE  0
#define RDW_GREEN 1
#define RDW_BLUE  2
#define RLW_NONE  0
#define RLW_GREEN 1
#define RLW_BLUE  2

// Darken / Lighten enums for Green
#define GDW_NONE  0
#define GDW_RED   1
#define GDW_BLUE  2
#define GLW_NONE  0
#define GLW_RED   1
#define GLW_BLUE  2

// Darken / Lighten enums for Blue
#define BDW_NONE  0
#define BDW_RED   1
#define BDW_GREEN 2
#define BLW_NONE  0
#define BLW_RED   1
#define BLW_GREEN 2

// Replace / Copy enums
#define CR_NONE       0
#define CR_FROM_GREEN 1
#define CR_FROM_BLUE  2
#define CG_NONE       0
#define CG_FROM_RED   1
#define CG_FROM_BLUE  2
#define CB_NONE       0
#define CB_FROM_RED   1
#define CB_FROM_GREEN 2

// Channel removal enums
#define REM_NONE 0
#define REM_RED  1
#define REM_GREEN 2
#define REM_BLUE 3
#define REM_ALL  4

// Channel isolation enums (for preview)
#define ISO_NONE  0
#define ISO_RED   1
#define ISO_GREEN 2
#define ISO_BLUE  3


// Stage 0: Assisted two-point recovery for a compacted or shifted channel.
// Combo identifiers are emitted by Resolve. Keep them bare in the enum list
// and use literal numeric values in the transform to avoid Metal macro clashes.
DEFINE_UI_PARAMS(rangeRecoveryMode, 🎯 Recovery Target, DCTLUI_COMBO_BOX, 0, { RR_OFF, RR_AUTO, RR_RED, RR_GREEN, RR_BLUE }, { Off, Auto, Red, Green, Blue })
DEFINE_UI_PARAMS(rangeRecoveryDark, ⚫ Step 1 Dark Neutral, DCTLUI_COLOR_PICKER, 0.0f, 0.0f, 0.0f)
DEFINE_UI_PARAMS(rangeRecoveryBright, ⚪ Step 2 Bright Neutral, DCTLUI_COLOR_PICKER, 1.0f, 1.0f, 1.0f)
DEFINE_UI_PARAMS(rangeRecoveryStrength, 🧪 Recovery Strength, DCTLUI_SLIDER_FLOAT, 1.0f, 0.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(rangeRecoveryMaxGain, 🛡️ Recovery Max Gain, DCTLUI_SLIDER_FLOAT, 4.0f, 1.0f, 8.0f, 0.01f)


// Stage 1: Global controls
DEFINE_UI_PARAMS(globalOffset,   🌐 Global Offset,   DCTLUI_SLIDER_FLOAT, 0.0f, -0.5f, 0.5f, 0.001f)
DEFINE_UI_PARAMS(globalShadows,  🌑 Global Lift,  DCTLUI_SLIDER_FLOAT, 0.0f, -0.5f, 0.5f, 0.001f)
